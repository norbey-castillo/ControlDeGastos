<?xml version="1.0" encoding="utf-8"?>

<!-- Diseño individual de cada movimiento del historial -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_tarjeta"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="18dp">

    <!-- Información del movimiento -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvHistorialDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textColor="#173F30"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Categoría -->
        <TextView
            android:id="@+id/tvHistorialCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Categoría"
            android:textColor="#718078"
            android:textSize="13sp" />

        <!-- Fecha -->
        <TextView
            android:id="@+id/tvHistorialFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Fecha"
            android:textColor="#8A9690"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Monto alineado a la derecha -->
    <TextView
        android:id="@+id/tvHistorialMonto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="end|center_vertical"
        android:text="Q 100.00"
        android:textColor="#24845D"
        android:textSize="17sp"
        android:textStyle="bold" />

</LinearLayout>
