<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F3F5F1">

    <!-- ENCABEZADO -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Historial de movimientos"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#173F30" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Consulta y organiza tus finanzas"
        android:textSize="14sp"
        android:textColor="#718078" />

    <!-- BOTÓN PARA VOLVER AL DASHBOARD -->
    <Button
        android:id="@+id/btnVolverHistorial"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_boton_secundario"
        android:backgroundTint="@null"
        android:text="‹  Volver al inicio"
        android:textAllCaps="false"
        android:textColor="#173F30"
        android:textSize="14sp"
        android:elevation="1dp"/>

    <!-- RESUMEN DE MOVIMIENTOS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/bg_saldo"
        android:elevation="3dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVIDAD FINANCIERA"
            android:textColor="#C9DED1"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvTotalMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Movimientos registrados: 0"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- SECCIÓN DE FILTROS -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Filtrar movimientos"
        android:textColor="#173F30"
        android:textSize="19sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_tarjeta"
        android:elevation="2dp">

        <!-- FILTRO POR TIPO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de movimiento"
            android:textColor="#718078"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spFiltroTipo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_filtro"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

        <!-- FILTRO POR CATEGORÍA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Categoría"
            android:textColor="#718078"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spFiltroCategoria"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_filtro"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

    </LinearLayout>

    <!-- MENSAJE CUANDO NO EXISTEN MOVIMIENTOS -->
    <TextView
        android:id="@+id/tvHistorialVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_tarjeta"
        android:gravity="center"
        android:padding="24dp"
        android:text="No hay movimientos registrados."
        android:textColor="#718078"
        android:textSize="14sp"
        android:visibility="gone"/>

    <!-- LISTA DE MOVIMIENTOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistorial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

</LinearLayout>
